# ==========================================
# InterviewPro AI – Environment Configuration
# ==========================================

# Application
PROJECT_NAME="InterviewPro AI"
ENVIRONMENT=development

# Database Configuration (PostgreSQL / SQLite)
# For production PostgreSQL: postgresql://user:password@localhost:5432/interviewpro_db
# For local development zero-config: sqlite:///./interviewpro.db
DATABASE_URL=sqlite:///./interviewpro.db

# JWT Security
SECRET_KEY=interviewpro-super-secret-jwt-key-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Language Model API
# Add your Google Gemini API Key here (or OpenAI API Key)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
